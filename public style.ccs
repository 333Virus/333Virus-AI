:root {
    --bg: #050505;
    --panel: #101510;
    --green: #00FF41;
    --green-dim: #008822;
    --text: #e0e0e0;
    --mono: 'Fira Code', monospace;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--mono);
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.hidden { display: none !important; }

/* --- INTRO ANIMATION --- */
#intro-screen {
    position: fixed; inset: 0;
    background: var(--bg); z-index: 9999;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    transition: opacity 1s ease;
}
.logo {
    position: absolute; top: 20px; left: 20px;
    color: var(--green); font-weight: bold;
    text-shadow: 0 0 10px var(--green);
}
.intro-content { text-align: center; }
#type-line1 { font-size: 2rem; color: var(--green); margin-bottom: 10px; }
#type-line2 { font-size: 1.2rem; color: var(--green-dim); }
.scanlines {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2));
    background-size: 100% 4px;
    animation: scan 10s linear infinite;
}
@keyframes scan { from { background-position: 0 0; } to { background-position: 0 100vh; } }

/* --- CHAT INTERFACE --- */
#chat-screen {
    display: flex; flex-direction: column; height: 100vh;
}

.top-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 15px 20px; background: var(--panel);
    border-bottom: 1px solid var(--green-dim);
}
.header-info h1 { font-size: 1.2rem; color: var(--green); }
.header-info .mode { font-size: 0.8rem; color: var(--green-dim); }
.header-actions { display: flex; gap: 15px; align-items: center; }
.status { font-size: 0.8rem; display: flex; align-items: center; gap: 5px; }
.dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 8px var(--green); }
#new-chat-btn {
    background: transparent; border: 1px solid var(--green-dim);
    color: var(--green); padding: 5px 10px; cursor: pointer;
    font-family: var(--mono); transition: 0.2s;
}
#new-chat-btn:hover { background: var(--green-dim); color: #000; }

/* --- MAIN CHAT --- */
#chat-container {
    flex: 1; padding: 20px; overflow-y: auto;
    display: flex; flex-direction: column; gap: 20px;
}
#chat-container::-webkit-scrollbar { width: 6px; }
#chat-container::-webkit-scrollbar-thumb { background: var(--green-dim); }

#welcome-message { text-align: center; margin-top: 10vh; color: var(--green); }
#welcome-message h2 { font-size: 1.8rem; margin-bottom: 10px; }
#welcome-message p { color: var(--text); font-size: 0.9rem; }

.message { max-width: 90%; line-height: 1.5; font-size: 0.95rem; }
.user-message {
    align-self: flex-end; background: #1a1a1a;
    border: 1px solid #333; padding: 12px 16px; border-radius: 8px 8px 0 8px;
}
.ai-message {
    align-self: flex-start; background: var(--panel);
    border: 1px solid var(--green-dim); padding: 15px;
    border-radius: 8px 8px 8px 0; box-shadow: 0 0 10px rgba(0,255,65,0.05);
    white-space: pre-wrap;
}

/* Code Blocks */
.code-container { margin: 10px 0; border: 1px solid var(--green-dim); border-radius: 4px; overflow: hidden; }
.code-header {
    background: #000; padding: 5px 10px; display: flex; justify-content: space-between;
    font-size: 0.8rem; color: var(--green-dim); border-bottom: 1px solid var(--green-dim);
}
.code-header button {
    background: none; border: none; color: var(--green); cursor: pointer; font-family: var(--mono);
}
.code-block {
    background: #050505; padding: 10px; overflow-x: auto;
    color: #a8ffb2; font-family: var(--mono); font-size: 0.85rem;
}

/* --- INPUT AREA --- */
.input-area {
    padding: 15px 20px; background: var(--panel);
    border-top: 1px solid var(--green-dim);
}
.input-wrapper {
    display: flex; align-items: center; gap: 10px;
    background: #000; border: 1px solid var(--green-dim);
    padding: 10px; border-radius: 8px;
}
textarea {
    flex: 1; background: transparent; border: none; color: var(--text);
    font-family: var(--mono); font-size: 1rem; resize: none; outline: none;
    max-height: 150px;
}
.icon-btn {
    background: none; border: none; color: var(--green-dim);
    font-size: 1.2rem; cursor: pointer; transition: 0.2s;
}
.icon-btn:hover { color: var(--green); text-shadow: 0 0 8px var(--green); }
.send { color: var(--green); }
